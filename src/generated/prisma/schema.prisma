generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  BLOGGER
  BRAND
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  CAMPAIGN_MANAGER
  CREATOR_MANAGER
  HR
  ADS_MANAGER
}

enum RecordStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum JobApplicationStatus {
  NEW
  IN_REVIEW
  ACCEPTED
  REJECTED
}

enum ContactMessageStatus {
  NEW
  IN_REVIEW
  REPLIED
  ARCHIVED
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

enum ApplicantType {
  TEAM
  MARKETER
  CREATOR
  UGC
  MODEL
  OTHER
}

enum RequestType {
  CONSULTATION
  CAMPAIGN
  AD
  JOB
}

enum RequestStatus {
  NEW
  IN_REVIEW
  IN_PROGRESS
  DONE
  REJECTED
}

enum ProfileContractStatus {
  PENDING
  CONTRACTED
}

enum ContractReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractPartyType {
  BLOGGER
  BRAND
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  SNAPCHAT
}

enum AdPlacement {
  HOME
  OFFERS
  ADS_PAGE
}

enum AdSource {
  COMPANY
  BRAND
}

enum MessageSender {
  ADMIN
  BLOGGER
}

// ==========================================
// AUTH & USER MODELS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  role       UserRole  @default(USER)
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  profile              Profile?
  bloggerProfile       BloggerProfile?
  brandProfile         BrandProfile?
  staffProfile         StaffProfile?
  uploads              File[]           @relation("FileOwner")
  jobApplications      JobApplication[] @relation("Applicant")
  reviewedApplications JobApplication[] @relation("ApplicationReviewer")
  createdServices      Service[]        @relation("ServiceAuthor")
  createdJobOpenings   JobOpening[]     @relation("JobOpeningAuthor")
  createdAds           Ad[]             @relation("AdAuthor")
  submittedRequests    Request[]        @relation("UserRequests")

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  phone       String?
  city        String?
  governorate String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile")
}

// ==========================================
// ADMIN & STAFF MANAGEMENT
// ==========================================

model StaffProfile {
  id            String         @id @default(cuid())
  userId        String?        @unique
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String         @unique
  adminRole     AdminRole
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  requests      Request[]      @relation("RequestAssignee")
  conversations Conversation[]

  @@map("staff_profile")
}

// ==========================================
// PROFILES & CONTRACTS
// ==========================================

model BloggerProfile {
  id           String                @id @default(cuid())
  userId       String                @unique
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  niche        String?
  handles      String?
  platforms    Platform[]            @default([])
  followers    Int                   @default(0)
  monthlyViews String?
  audienceSize String?
  phone        String?
  governorate  String?
  city         String?
  instagramUrl String?
  tiktokUrl    String?
  youtubeUrl   String?
  socialLinks  String[]              @default([])
  portfolioUrl String?
  bio          String?               @db.Text
  status       ProfileContractStatus @default(PENDING)
  contracts    ContractRequest[]
  conversation Conversation?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status])
  @@map("blogger_profile")
}

model BrandProfile {
  id            String                @id @default(cuid())
  userId        String                @unique
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String?
  industry      String?
  contactName   String?
  contactPhone  String?
  budget        String?
  goal          String?
  website       String?
  campaignGoals String?               @db.Text
  status        ProfileContractStatus @default(PENDING)
  contracts     ContractRequest[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status])
  @@map("brand_profile")
}

model ContractRequest {
  id           String               @id @default(cuid())
  partyType    ContractPartyType
  status       ContractReviewStatus @default(PENDING)
  notes        String               @default("") @db.Text
  bloggerId    String?
  blogger      BloggerProfile?      @relation(fields: [bloggerId], references: [id], onDelete: Cascade)
  brandId      String?
  brand        BrandProfile?        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, partyType])
  @@map("contract_request")
}

model Conversation {
  id            String         @id @default(cuid())
  bloggerId     String         @unique
  blogger       BloggerProfile @relation(fields: [bloggerId], references: [id], onDelete: Cascade)
  managerId     String?
  manager       StaffProfile?  @relation(fields: [managerId], references: [id], onDelete: SetNull)
  messages      Message[]
  lastMessageAt DateTime?
  createdAt     DateTime       @default(now())

  @@map("conversation")
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  senderUserId   String
  text           String        @db.Text
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

// ==========================================
// REQUESTS & OPERATIONS
// ==========================================

model Request {
  id            String        @id @default(cuid())
  type          RequestType
  status        RequestStatus @default(NEW)
  fromName      String
  fromEmail     String
  fromPhone     String?
  subject       String
  message       String?       @db.Text
  payload       Json?
  attachmentUrl String?
  userId        String?
  user          User?         @relation("UserRequests", fields: [userId], references: [id], onDelete: SetNull)
  assignedToId  String?
  assignedTo    StaffProfile? @relation("RequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type, status])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("request")
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@map("contact_message")
}

model JobOpening {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  department     String
  location       String?
  employmentType String?
  description    String           @db.Text
  status         RecordStatus     @default(DRAFT)
  sortOrder      Int              @default(0)
  authorId       String?
  author         User?            @relation("JobOpeningAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  applications   JobApplication[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, sortOrder])
  @@map("job_opening")
}

model JobApplication {
  id           String               @id @default(cuid())
  type         ApplicantType        @default(OTHER)
  status       JobApplicationStatus @default(NEW)
  openingId    String?
  opening      JobOpening?          @relation(fields: [openingId], references: [id], onDelete: SetNull)
  applicantId  String?
  applicant    User?                @relation("Applicant", fields: [applicantId], references: [id], onDelete: SetNull)
  reviewerId   String?
  reviewer     User?                @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String
  age          Int?
  city         String?
  governorate  String?
  gender       String?
  fieldOfWork  String?
  socialLinks  String[]             @default([])
  portfolioUrl String?
  message      String?              @db.Text
  resumeFileId String?              @unique
  resumeFile   File?                @relation("JobApplicationResume", fields: [resumeFileId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([type, status])
  @@index([openingId])
  @@map("job_application")
}

// ==========================================
// CONTENT, SERVICES & ADS
// ==========================================

model Service {
  id          String       @id @default(cuid())
  slug        String?      @unique
  title       String
  summary     String?      @db.Text
  description String?      @db.Text
  details     String?      @db.Text
  priceLabel  String?
  status      RecordStatus @default(DRAFT)
  published   Boolean      @default(true)
  sortOrder   Int          @default(0)
  authorId    String?
  author      User?        @relation("ServiceAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, sortOrder])
  @@index([published, createdAt])
  @@map("service")
}

model ServiceTier {
  id          String   @id @default(cuid())
  name        String
  eyebrow     String
  scope       String
  offer       String
  features    String[]
  savingsRate Float
  accent      String
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_tier")
}

model Ad {
  id          String       @id @default(cuid())
  slug        String?      @unique
  title       String
  summary     String?      @db.Text
  body        String?      @db.Text
  content     Json?
  brandName   String?
  placement   AdPlacement  @default(ADS_PAGE)
  source      AdSource?
  status      RecordStatus @default(DRAFT)
  published   Boolean      @default(false)
  startsAt    DateTime?    @db.Date
  endsAt      DateTime?    @db.Date
  publishedAt DateTime?
  expiresAt   DateTime?
  authorId    String?
  author      User?        @relation("AdAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, placement, publishedAt, expiresAt])
  @@index([placement, published, startsAt, endsAt])
  @@map("ad")
}

model Creator {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  handle     String
  niche      String
  platforms  String[]
  reach      String
  engagement String
  location   String
  image      String
  accent     String
  bio        String   @default("")
  published  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("creator")
}

model ShowcaseCreator {
  id        String   @id @default(cuid())
  name      String
  niche     String
  reach     String
  image     String
  accent    String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@map("showcase_creator")
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  industry    String
  campaign    String
  description String
  services    String[]
  views       String
  roi         String
  color       String
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("brand")
}

model CaseStudy {
  id        String            @id @default(cuid())
  slug      String            @unique
  brand     String
  title     String
  goal      String            @db.Text
  summary   String?           @db.Text
  published Boolean           @default(false)
  metrics   CaseStudyMetric[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([published, createdAt])
  @@map("case_study")
}

model CaseStudyMetric {
  id          String    @id @default(cuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  platform    Platform
  views       BigInt    @default(0)
  reach       BigInt    @default(0)
  engagement  BigInt    @default(0)

  @@unique([caseStudyId, platform])
  @@map("case_study_metric")
}

// ==========================================
// FILE MANAGEMENT & AUDITING
// ==========================================

model File {
  id           String          @id @default(cuid())
  key          String          @unique
  originalName String
  contentType  String
  sizeBytes    Int
  visibility   FileVisibility  @default(PRIVATE)
  ownerId      String?
  owner        User?           @relation("FileOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  resumeFor    JobApplication? @relation("JobApplicationResume")
  createdAt    DateTime        @default(now())

  @@index([ownerId, createdAt])
  @@map("file")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String?
  actorName  String?
  action     String
  entity     String
  entityId   String?
  details    String?  @default("")
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}

model SiteSettings {
  id          String       @id @default(cuid())
  siteName    String       @default("Proganda Studio")
  email       String       @default("")
  whatsapp    String       @default("")
  phone       String?
  address     String?
  instagram   String?      @default("")
  tiktok      String?      @default("")
  youtube     String?      @default("")
  facebook    String?      @default("")
  socialLinks SocialLink[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("site_settings")
}

model SocialLink {
  id             String       @id @default(cuid())
  platform       String
  title          String?
  url            String
  icon           String?
  sortOrder      Int          @default(0)
  siteSettingsId String
  siteSettings   SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([siteSettingsId, sortOrder])
  @@map("social_link")
}
